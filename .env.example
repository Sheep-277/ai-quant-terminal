# 可公开提交的开发模板，与 backend/.env.example 的参数保持一致；不填写真实凭证。
# 推荐从 backend 目录启动，将 backend/.env.example 复制为 backend/.env。
# Settings 读取当前工作目录的 .env，两份实际 .env 不会自动合并。
# 默认纯 Mock：不要求数据库或 API Key。修改实际 .env 后需重启后端。

PROJECT_NAME=AI Quant Terminal API
API_PREFIX=/api/v1

# 公开行情演示：DATA_PROVIDER=real、REAL_PROVIDER_NAME=YahooFinance，
# REAL_PROVIDER_BASE_URL=https://query1.finance.yahoo.com，无需行情 API Key。
# 延迟、限流、不可用和 Mock 回退仍需按页面分区的来源标签判断。
DATA_PROVIDER=mock
REAL_PROVIDER_NAME=RealMarketDataProvider
REAL_PROVIDER_BASE_URL=
# 此处填保存密钥的环境变量名，而不是密钥本身；YahooFinance 留空。
REAL_PROVIDER_API_KEY_ENV=
REAL_PROVIDER_API_KEY_HEADER=Authorization

# password 仅为占位符；在实际 .env 中改成本机配置，不提交真实连接串。
# 密码中的 @、:、/、# 等特殊字符需按 URL 规则编码。
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_quant_terminal?charset=utf8mb4

# 数据库创建、init_db 和 seed 完成后再按需开启；seed 是模拟样本。
ENABLE_PROVIDER_STATUS_LOGGING=false

ENABLE_MARKET_DATABASE_READS=false
# 展示 Provider 行情时建议保持 false，避免本地 seed 数据覆盖个股行情。
ENABLE_STOCK_DATABASE_READS=false
ENABLE_MONITOR_DATABASE_READS=false
ENABLE_AI_RESEARCH_DATABASE_READS=false
ENABLE_STRATEGY_DATABASE_READS=false
ENABLE_BACKTEST_DATABASE_READS=false
ENABLE_PORTFOLIO_DATABASE_READS=false

# 只写本地研究、策略、回测及模拟账户记录，不连接真实券商资金。
ENABLE_AI_RESEARCH_DATABASE_WRITES=false
ENABLE_STRATEGY_DATABASE_WRITES=false
ENABLE_BACKTEST_DATABASE_WRITES=false
ENABLE_PORTFOLIO_DATABASE_WRITES=false

# 可选百炼摘要：仅解释已有证据，不替代量化计算；启用后可能产生费用。
# 在实际 .env 中填写 Key 和与账户地域/模型对应的 OpenAI 兼容 Base URL。
# 例如 https://dashscope.aliyuncs.com/compatible-mode/v1；不要提交专属 Endpoint。
ENABLE_LLM_RESEARCH=false
BAILIAN_API_KEY=
BAILIAN_BASE_URL=
BAILIAN_MODEL=qwen-plus
BAILIAN_TIMEOUT_SECONDS=30
BAILIAN_SUMMARY_MAX_TOKENS=512

# 可选新闻搜索：mock / tavily / serpapi；后两者需 Key，可能产生费用。
SEARCH_PROVIDER=mock
SEARCH_API_KEY=
SEARCH_RESULT_LIMIT=5
SEARCH_TIMEOUT_SECONDS=10
