# 可公开提交的开发模板，与根目录 .env.example 的参数保持一致；不填写真实凭证。
# 推荐从 backend 目录启动，将 backend/.env.example 复制为 backend/.env。
# Settings 读取当前工作目录的 .env，两份实际 .env 不会自动合并。
# 默认纯 Mock：不要求数据库或 API Key。修改实际 .env 后需重启后端。

PROJECT_NAME=AI Quant Terminal API

# 当前 API URL 前缀。未来如果 V2 并存，可以再拆成 API_V1_PREFIX / API_V2_PREFIX。
API_PREFIX=/api/v1

# 当前后端数据源模式。首次启动默认 Mock，不依赖外部网络。
# 公开行情演示改为 real、YahooFinance、https://query1.finance.yahoo.com，无需行情 Key。
DATA_PROVIDER=mock

# Provider 配置。YahooFinance 用于课程演示真实行情最小闭环；正式生产应替换为授权行情供应商。
# REAL_PROVIDER_API_KEY_ENV 填“保存密钥的环境变量名”，不要直接填真实密钥；YahooFinance 可留空。
# REAL_PROVIDER_API_KEY_HEADER 默认为 Authorization；部分真实供应商可改为 X-API-Key。
REAL_PROVIDER_NAME=RealMarketDataProvider
REAL_PROVIDER_BASE_URL=
REAL_PROVIDER_API_KEY_ENV=
REAL_PROVIDER_API_KEY_HEADER=Authorization

# 后端数据库连接地址。默认指向本地 MySQL；请把 password 改成你的本机 MySQL 密码。
# password 是占位符，不提交真实连接串；密码中的 URL 特殊字符需编码。
# 测试可临时使用 sqlite+pysqlite:///:memory:。
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_quant_terminal?charset=utf8mb4

# 是否在访问 /api/v1/provider/status 时写入 provider_status_logs。
# 默认关闭，避免未启动数据库时影响前端访问；确认数据库可用后再改为 true。
ENABLE_PROVIDER_STATUS_LOGGING=false

# 是否让 /api/v1/market/overview 优先从 latest_quotes 表构造市场总览。
# 默认关闭；确认已经执行 init_db 和 seed 后再改为 true。
ENABLE_MARKET_DATABASE_READS=false

# 是否让 /api/v1/stock/research 优先从 stocks/latest_quotes 读取 profile 和 quote。
# 默认关闭；要演示 YahooFinance 真实行情时保持 false，避免 seed 数据覆盖 Provider quote/K线。
ENABLE_STOCK_DATABASE_READS=false

# 是否让 /api/v1/monitor/stream 优先从 signals 表读取实时监控信号集。
# 默认关闭；确认已经执行 init_db 和 seed 后再改为 true。
ENABLE_MONITOR_DATABASE_READS=false

# 是否让 /api/v1/research/task 优先从 agent_tasks 表读取最近任务元信息。
# 默认关闭；确认已经执行 init_db 后再改为 true。
ENABLE_AI_RESEARCH_DATABASE_READS=false

# 是否让 POST /api/v1/research/tasks 保存 AI Research 任务基础信息。
# 默认关闭；确认已经执行 init_db 后再改为 true。
ENABLE_AI_RESEARCH_DATABASE_WRITES=false

# 是否让 /api/v1/strategy/lab 优先读取 strategies 表。
ENABLE_STRATEGY_DATABASE_READS=false

# 是否让 POST /api/v1/strategies 把用户提交的策略草案写入 strategies 表。
ENABLE_STRATEGY_DATABASE_WRITES=false

# 是否让 /api/v1/backtest/result 优先读取 backtests/equity_curve_points/backtest_trades 表。
ENABLE_BACKTEST_DATABASE_READS=false

# 是否让 POST /api/v1/backtests 在返回任务回执时保存当前 Mock 回测快照。
ENABLE_BACKTEST_DATABASE_WRITES=false

# 是否让 /api/v1/portfolio/summary 优先读取 portfolios/positions/orders/trades 表。
ENABLE_PORTFOLIO_DATABASE_READS=false

# 是否让 Portfolio 相关接口保存模拟下单结果；仅写入本地模拟表，不连接真实券商。
ENABLE_PORTFOLIO_DATABASE_WRITES=false

# 可选：AI Research 解释摘要。开启后只让 LLM 解释结构化证据，不参与量化计算。
# 在实际 .env 中填写 Key 和匹配账户地域/模型的 OpenAI 兼容 Base URL。
# 例如 https://dashscope.aliyuncs.com/compatible-mode/v1；不要提交专属 Endpoint。
# LLM 和真实搜索调用可能产生费用，默认关闭。
ENABLE_LLM_RESEARCH=false
BAILIAN_API_KEY=
BAILIAN_BASE_URL=
BAILIAN_MODEL=qwen-plus
BAILIAN_TIMEOUT_SECONDS=30
BAILIAN_SUMMARY_MAX_TOKENS=512

# 可选：AI Research 公开新闻/搜索源。mock 为本地演示；tavily/serpapi 需要 SEARCH_API_KEY。
SEARCH_PROVIDER=mock
SEARCH_API_KEY=
SEARCH_RESULT_LIMIT=5
SEARCH_TIMEOUT_SECONDS=10
